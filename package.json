{
  "name": "stickman-fighter",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "lint": "biome lint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run typecheck:scripts && npm run lint && vitest run && npm run generate:check && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:audio": "node scripts/audio-smoke.mjs",
    "smoke:update": "node scripts/update-smoke.mjs",
    "smoke:preview": "node scripts/animation-preview-smoke.mjs",
    "smoke:rotation": "node scripts/rotation-smoke.mjs",
    "generate:spin-boxes": "node scripts/generate-spin-boxes.mjs",
    "smoke:spin": "node scripts/spin-smoke.mjs",
    "smoke:style": "node scripts/style-smoke.mjs",
    "smoke:kicks": "node scripts/leg-kicks-smoke.mjs",
    "generate:strike-boxes": "node scripts/generate-strike-boxes.mjs",
    "smoke:strikes": "node scripts/turning-strikes-smoke.mjs",
    "generate:walk": "node scripts/run-python.mjs scripts/generate-walk-poses.py",
    "smoke:footwork": "node scripts/footwork-smoke.mjs",
    "smoke:crouch": "node scripts/crouching-kicks-smoke.mjs",
    "generate:tornado": "node scripts/generate-tornado-combo.mjs",
    "smoke:tornado": "node scripts/tornado-combo-smoke.mjs",
    "generate:spin-poses": "node scripts/run-python.mjs scripts/generate-spin-poses.py",
    "cpu:tournament": "node scripts/cpu-tournament.mjs",
    "smoke:cpu": "node scripts/cpu-smoke.mjs",
    "smoke:stages": "node scripts/stage-smoke.mjs",
    "generate:uppercut": "node scripts/generate-jumping-uppercut.mjs",
    "smoke:uppercut": "node scripts/jumping-uppercut-smoke.mjs",
    "generate:contacts": "node scripts/generate-contact-geometry.mjs",
    "generate:dwit": "node scripts/generate-dwit-chagi.mjs",
    "smoke:contacts": "node scripts/contact-timing-smoke.mjs",
    "smoke:knee": "node scripts/knee-strike-smoke.mjs",
    "smoke:dwit": "node scripts/dwit-chagi-smoke.mjs",
    "generate:left-turn": "node scripts/generate-left-turn-kick.mjs",
    "smoke:left-turn": "node scripts/left-turn-kick-smoke.mjs",
    "generate:double-high": "node scripts/generate-double-high-kick.mjs",
    "smoke:double-high": "node scripts/double-high-kick-smoke.mjs",
    "generate:spin-high-middle": "node scripts/generate-spin-high-middle.mjs",
    "smoke:spin-high-middle": "node scripts/spin-high-middle-smoke.mjs",
    "generate:middle-high-low": "node scripts/generate-middle-high-low.mjs",
    "generate:move-table": "node scripts/generate-move-table.mjs",
    "smoke:middle-high-low": "node scripts/middle-high-low-smoke.mjs",
    "generate:check": "npm run generate:spin-poses -- --check && npm run generate:spin-boxes -- --check && npm run generate:strike-boxes -- --check && npm run generate:walk -- --check && npm run generate:tornado -- --check && npm run generate:uppercut -- --check && npm run generate:dwit -- --check && npm run generate:left-turn -- --check && npm run generate:double-high -- --check && npm run generate:spin-high-middle -- --check && npm run generate:middle-high-low -- --check && npm run generate:middle-high-punch -- --check && npm run generate:punch-kick -- --check && npm run generate:kick-punch -- --check && npm run generate:contacts -- --check && npm run generate:move-table -- --check && npm run generate:sound-meta -- --check",
    "check:full": "npm run check && npm run smoke:all",
    "smoke:core": "node scripts/run-smokes.mjs",
    "smoke:all": "node scripts/run-smokes.mjs all",
    "generate:middle-high-punch": "node scripts/generate-middle-high-punch.mjs",
    "smoke:middle-high-punch": "node scripts/middle-high-punch-smoke.mjs",
    "generate:sound-meta": "node scripts/generate-sound-meta.mjs",
    "generate:punch-kick": "node scripts/generate-punch-kick-combo.mjs",
    "generate:kick-punch": "node scripts/generate-kick-punch-combo.mjs",
    "smoke:punch-kick-combos": "node scripts/punch-kick-combos-smoke.mjs",
    "smoke:effects": "node scripts/effects-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
