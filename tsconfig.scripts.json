{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "vite/client"]
  },
  "include": ["scripts/**/*.mjs", "scripts/**/*.ts"],
  "exclude": ["scripts/**/*smoke.mjs"]
}
